root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{ts,js,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
